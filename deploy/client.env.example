# client.env — per-machine configuration for an Ambient install.
# Copy to ~/.ambient/client.env on the client Mac. Sourced by the watchdog,
# cleanup, pause scripts, and ambient-start.sh. shell syntax, no spaces around =.

# Who this machine belongs to (used in alert subjects and reports)
CLIENT_NAME="client-name-here"

# NOTE: the Anthropic API key is NOT stored here. It lives in the macOS
# Keychain (service "anthropic-api-key", account "ambient-daemon") — the
# installer prompts for it. client.env holds only non-secret config plus
# the operator-alert Resend key.

# Where the ambient repo is installed on this machine.
AMBIENT_DIR="$HOME/ambient"

# Where watchdog failure/recovery alerts go. This is the OPERATOR (Mike),
# not the client — alerts are ops signals, not client comms.
ALERT_TO="poolkraftllc@gmail.com"

# Resend API key used only for the operator alerts above.
RESEND_API_KEY=""

# Optional: Obsidian vault path for daily journal export. Leave empty on
# client machines (dashboard + SQLite are the source of truth there).
VAULT_PATH=""

# Retention (days). Cleanup job enforces these nightly at 3 AM.
RETENTION_VIDEO_DAYS=7
RETENTION_OCR_DAYS=14

# Capability toggles for the intelligence layer (Phase 3). A client may want
# workflow detection but not commitment tracking.
ENABLE_WORKFLOW_DETECTOR=true
ENABLE_SOP_LIBRARY=true
ENABLE_COMMITMENT_TRACKER=false
ENABLE_DECISION_LOG=true
ENABLE_DRIFT=true

# Operator mode: true on Mike's machine (shows all panels), false for clients.
OPERATOR_MODE=false
